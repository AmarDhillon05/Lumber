{
  "expo": {
    "name": "Lumber",
    "slug": "lumber",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.amardhillon.lumber",
      "infoPlist": {
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": true,
          "iosMicrophonePermission": "Lumber records your drums while the song plays."
        }
      ],
      "onnxruntime-react-native",
      "expo-sharing",
      "expo-document-picker",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Lumber films you drumming while you record a take.",
          "microphonePermission": "Lumber records your drums while the song plays.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Lumber only adds your drum videos to Photos when you tap Save to Photos.",
          "savePhotosPermission": "Lumber saves your drum videos to Photos when you tap Save to Photos.",
          "granularPermissions": ["video"]
        }
      ]
    ],
    "scheme": "lumber",
    "platforms": [
      "ios"
    ]
  }
}
